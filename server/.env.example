# ===========================================================================
#  Portfolio backend configuration. Copy to ".env" and fill in.
#  Every value has a safe default — with NOTHING set, the contact form runs
#  in "console" mode (submissions are logged, not emailed). Set EMAIL_PROVIDER
#  + the matching block to actually deliver mail.
# ===========================================================================

# ---- App ------------------------------------------------------------------
ENVIRONMENT=production
# Where the built static site lives. In Docker this is set for you (/srv/site).
# For a local non-Docker run from the repo root, leave unset (defaults to repo).
# SITE_DIR=/srv/site

# How many reverse-proxy hops to trust for the real client IP.
# Caddy or nginx in front = 1. Direct exposure (no proxy) = 0.
FORWARDED_ALLOW_HOPS=1

# ---- Where inquiries go ---------------------------------------------------
CONTACT_TO=hello@abedin.dev
CONTACT_FROM=noreply@abedin.dev
CONTACT_FROM_NAME=Abedin M. Portfolio

# ---- CORS / origin lock (comma-separated; "*" to disable) -----------------
ALLOWED_ORIGINS=https://abedin.dev,https://www.abedin.dev

# ---- Rate limiting --------------------------------------------------------
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=3600
GLOBAL_RATE_LIMIT_MAX=60

# ---- Anti-spam ------------------------------------------------------------
MIN_SUBMIT_SECONDS=2
MAX_MESSAGE_CHARS=5000

# ---- Cloudflare Turnstile (optional CAPTCHA; leave blank to disable) ------
# Get keys at https://dash.cloudflare.com -> Turnstile.
# Put the SITE key in the frontend (index.html), the SECRET key here.
TURNSTILE_SECRET=

# ===========================================================================
#  EMAIL DELIVERY — pick ONE provider.
# ===========================================================================
# console | smtp | resend
EMAIL_PROVIDER=console

# ---- SMTP (Gmail app password, Mailgun, Amazon SES, Zoho, Postmark, …) -----
# Gmail example: host smtp.gmail.com, port 587, user=you@gmail.com,
#   password = a 16-char App Password (NOT your login password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

# ---- Resend (https://resend.com — simplest; verify your domain first) ------
RESEND_API_KEY=
